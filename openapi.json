{
    "openapi": "3.0.3",
    "info": {
        "title": "contactgegevensregister",
        "version": "0.0.1",
        "description": "Afgeschermd register dat gepseudonimiseerde BSN's en KvK-identiteiten koppelt aan versleutelde contactgegevens",
        "license": {
            "name": "AGPL-3.0-or-later"
        }
    },
    "components": {
        "securitySchemes": {
            "basic_auth": {
                "type": "http",
                "scheme": "basic"
            },
            "bearer_auth": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "Contactgegeven": {
                "type": "object",
                "required": [
                    "uuid",
                    "identiteit",
                    "soort",
                    "waarde",
                    "geverifieerdOp",
                    "isPrimair"
                ],
                "properties": {
                    "uuid": {
                        "type": "string"
                    },
                    "identiteit": {
                        "type": "string"
                    },
                    "soort": {
                        "type": "string"
                    },
                    "waarde": {
                        "type": "string"
                    },
                    "geverifieerdOp": {
                        "type": "string",
                        "nullable": true
                    },
                    "isPrimair": {
                        "type": "boolean"
                    }
                }
            },
            "Fout": {
                "type": "object",
                "required": [
                    "message"
                ],
                "properties": {
                    "message": {
                        "type": "string"
                    }
                }
            },
            "Identiteit": {
                "type": "object",
                "required": [
                    "uuid"
                ],
                "properties": {
                    "uuid": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "paths": {
        "/index.php/apps/contactgegevensregister/api/v1/identiteiten/{uuid}/contactgegevens": {
            "get": {
                "operationId": "contactgegeven-index",
                "summary": "List the contactgegevens of an identiteit",
                "tags": [
                    "contactgegeven"
                ],
                "security": [
                    {},
                    {
                        "bearer_auth": []
                    },
                    {
                        "basic_auth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "uuid",
                        "in": "path",
                        "description": "UUID of the identiteit",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "isGeverifieerd",
                        "in": "query",
                        "description": "Only return verified contactgegevens",
                        "schema": {
                            "type": "boolean",
                            "default": false
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Contactgegevens returned, oldest first",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Contactgegeven"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Identiteit not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Fout"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/index.php/apps/contactgegevensregister/api/v1/identiteiten": {
            "post": {
                "operationId": "identiteit-create",
                "summary": "Find or create the identiteit of an HMAC",
                "description": "During a key rotation the client also sends the HMAC of the previous key. An identiteit that only has that HMAC is re-keyed and keeps its UUID.",
                "tags": [
                    "identiteit"
                ],
                "security": [
                    {},
                    {
                        "bearer_auth": []
                    },
                    {
                        "basic_auth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "hmac"
                                ],
                                "properties": {
                                    "hmac": {
                                        "type": "string",
                                        "description": "HMAC-SHA256 of the login identifier, 64 lowercase hexadecimal characters"
                                    },
                                    "vorigeHmac": {
                                        "type": "string",
                                        "nullable": true,
                                        "default": null,
                                        "description": "HMAC of the login identifier with the previous key, only during a key rotation"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Existing identiteit found or re-keyed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Identiteit"
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "Identiteit created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Identiteit"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid HMAC, or vorigeHmac equals hmac",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Fout"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/index.php/apps/contactgegevensregister/api/v1/identiteiten/{uuid}": {
            "delete": {
                "operationId": "identiteit-destroy",
                "summary": "Delete an identiteit and its contactgegevens",
                "tags": [
                    "identiteit"
                ],
                "security": [
                    {},
                    {
                        "bearer_auth": []
                    },
                    {
                        "basic_auth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "uuid",
                        "in": "path",
                        "description": "UUID of the identiteit",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Identiteit deleted"
                    },
                    "404": {
                        "description": "Identiteit not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Fout"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "contactgegeven",
            "description": "The endpoints are public until the token system is added (ADR 0001 requires access to be denied by default)."
        },
        {
            "name": "identiteit",
            "description": "The endpoints are public until the token system is added (ADR 0001 requires access to be denied by default)."
        }
    ]
}
